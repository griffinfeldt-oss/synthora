# ─────────────────────────────────────────────────────────────────────────────
# Synthora environment. Copy to .env (or run `npm run setup`, which also
# generates the secrets). Every external service is optional locally: leave a
# key blank and that service runs in mock mode.
# ─────────────────────────────────────────────────────────────────────────────

# How much is real: demo (everything simulated), test (Stripe test keys) or live
# (real money). Live refuses to start until every check on Admin → Readiness
# passes and every launch gate in src/config/launch.ts is signed off.
# Blank: demo without a Stripe key, test with one. A Stripe key never means live.
APP_MODE=

# Public URL of the app (no trailing slash). Used in emails, webhooks, Stripe redirects.
APP_URL=http://localhost:3000
# Your domain, used for support/privacy email addresses and example links.
NEXT_PUBLIC_SITE_DOMAIN=synthora.market

# Postgres. Local: docker compose up -d. Supabase: use the pooled URL (port 6543,
# ?pgbouncer=true&connection_limit=1) for DATABASE_URL and the direct URL (5432) for DIRECT_URL.
DATABASE_URL=postgresql://synthora:synthora@localhost:5432/synthora
DIRECT_URL=postgresql://synthora:synthora@localhost:5432/synthora

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Encrypts sellers' partner API keys at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: put the old key here, the new one above, deploy, then run
# `npm run secrets:reencrypt` and clear this.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Extra addresses that receive operator alerts (reports, IP notices). Grants NO access:
# admins are granted with `npm run admin:grant -- you@example.com`.
ALERT_EMAILS=
# Admins need a second factor everywhere except demo mode; "required" forces it in demo too.
ADMIN_MFA=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). 24+ characters for live.
CRON_SECRET=

# Force every integration into mock mode, even when keys are present.
MOCK_MODE=false

# ── Stripe (payments, Connect Express payouts, Billing) ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_TAX_READY=false
# Signing secret of the platform webhook endpoint (/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Connect webhook endpoint (same URL, "Connected accounts" events)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional: a recurring $3/month Price id. If blank, Checkout creates the price inline.
STRIPE_SUBSCRIPTION_PRICE_ID=

# ── File storage (S3-compatible: Supabase Storage, Cloudflare R2, AWS S3) ───
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket for product images and designs
S3_PUBLIC_BUCKET=
# Private bucket for design originals, digital products and the upload quarantine.
# Required and must be a different bucket: private files never fall back to public.
# Add a lifecycle rule deleting objects under quarantine/ after 1 day.
S3_PRIVATE_BUCKET=
# Base URL that serves objects from the public bucket, e.g.
# https://<project>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# ── AI ───────────────────────────────────────────────────────────────────────
# Image model for "Make one with AI" (blank = built-in demo generator)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Claude writes listing titles/descriptions (blank = template copywriter)
ANTHROPIC_API_KEY=
# Kill switch for all AI generation. Limits and the daily budget are in src/config/launch.ts.
AI_STUDIO_ENABLED=true

# ── Email (blank = messages are only stored in the admin Outbox) ─────────────
RESEND_API_KEY=
EMAIL_FROM="Synthora <hello@synthora.market>"

# ── Fulfillment partners ────────────────────────────────────────────────────
# Sellers connect their OWN partner accounts in the app; these are platform-level.
# Force all partner calls into mock mode:
FULFILLMENT_MOCK=false
# Webhook secrets (any long random string; see README for where each goes)
PRINTIFY_WEBHOOK_SECRET=
PRINTFUL_WEBHOOK_SECRET=
GELATO_WEBHOOK_SECRET=
# Optional Printful OAuth app (otherwise sellers paste a private token)
PRINTFUL_CLIENT_ID=
PRINTFUL_CLIENT_SECRET=
